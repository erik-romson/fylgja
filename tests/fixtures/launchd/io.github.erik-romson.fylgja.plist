<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{HOME}}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>io.github.erik-romson.fylgja</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HOME}}/.local/bin/fylgja</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/.local/state/fylgja/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>{{HOME}}/.local/state/fylgja/launchd.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
